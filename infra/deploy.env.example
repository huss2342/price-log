# Copy to infra/deploy.env and fill in. That file is git-ignored: it names real
# resources in your subscription, which is exactly what should not be public.
#
#   cp infra/deploy.env.example infra/deploy.env

# Resource group holding the model deployment, database server and key vault
# that this app borrows rather than creates.
SHARED_RG=my-shared-rg

# Azure OpenAI account with a vision-capable deployment. The deployment itself
# defaults to "tag-extractor"; override OPENAI_DEPLOYMENT if yours differs.
OPENAI_ACCOUNT=my-openai-account

# Key vault holding the database password, and the name of that secret.
KEYVAULT=my-key-vault
DB_SECRET=pricelog-db-password

# PostgreSQL flexible server, and the login this app uses. That login should own
# only the pricelog database and hold no privileges on anything else on the
# server.
DB_SERVER=my-postgres-server
DB_USER=pricelog_app

# GitHub account or org that owns the ghcr.io/<owner>/price-log-api image.
GHCR_OWNER=my-github-account

# Optional. Defaults are fine unless you want to run more than one instance.
# RG=price-log
# LOCATION=eastus
# SWA_LOCATION=eastus2
# DB_NAME=pricelog
# OPENAI_DEPLOYMENT=tag-extractor
