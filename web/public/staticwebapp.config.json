{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/icons/*",
      "/*.{css,js,json,webmanifest,png,ico,txt}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
